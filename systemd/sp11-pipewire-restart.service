[Unit]
Description=Restart PipeWire after SP11 WSA routing is enabled
# This user-level service waits for the system-level sp11-wsa-routing.service
# to finish, then restarts PipeWire/WirePlumber so they connect to the speaker
# sink cleanly.
After=pipewire.service pipewire.socket
Wants=pipewire.service

[Service]
Type=oneshot
# Wait for the flag file written by sp11-enable-wsa-routing.sh
ExecStartPre=/bin/sh -c 'for i in $(seq 1 60); do [ -f /run/sp11-wsa-routing-done ] && exit 0; sleep 1; done; exit 1'
# Wait for the ALSA card to be fully available to this user session,
# then restart PipeWire/WirePlumber.
# The delay is critical: PipeWire starts during the GDM/login session
# before the ALSA card is fully registered, causing "Cannot get card
# index" errors. By the time this runs, pipewire.socket/pipewire.service/
# wireplumber.service have usually already crash-looped past systemd's
# start-limit and gone into "failed" state — `systemctl restart` on a
# start-limit-hit unit is a no-op, so reset-failed must run first or the
# stack never comes back up.
ExecStart=/bin/sh -c 'for i in $(seq 1 30); do aplay -l 2>/dev/null | grep -q X1E80100Microso && break; sleep 1; done; sleep 3; systemctl --user reset-failed wireplumber.service pipewire.service pipewire.socket pipewire-pulse.service pipewire-pulse.socket 2>/dev/null; systemctl --user restart wireplumber pipewire pipewire-pulse 2>/dev/null; sleep 2; rm -f /run/sp11-wsa-routing-done 2>/dev/null; true'
RemainAfterExit=yes

[Install]
WantedBy=default.target